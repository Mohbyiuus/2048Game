/* =========================
   主窗口
   ========================= */

QMainWindow{
    background-color:#0f172a;
    font-family:"MapleMono", sans-serif;
}

/* =========================
   标题
   ========================= */

QLabel#titleLabel{
    background:transparent;
    color:#f1f5f9;
    border:none;
    padding:12px 0px;
    font-size:36px;
    font-weight:900;
    letter-spacing:8px;

    min-height:70px;
    max-height:70px;
}

/* =========================
   分数
   ========================= */

QLabel#scoreLabel{
    background-color:#1e293b;
    color:#e2e8f0;
    border:2px solid #475569;
    border-radius:10px;
    padding:8px 18px;
    font-size:20px;
    font-weight:600;
    letter-spacing:1px;

    min-height:70px;
    max-height:70px;
}

/* =========================
   按钮
   ========================= */

QPushButton{
    background-color:#1e293b;
    color:#94a3b8;
    border:2px solid #334155;
    border-radius:10px;
    padding:10px 20px;
    font-size:15px;
    font-weight:600;
    letter-spacing:1px;

    min-width:100px;
    min-height:50px;
    max-height:70px;
}

QPushButton:hover{
    background-color:#334155;
    color:#f1f5f9;
    border-color:#f59e0b;
}

QPushButton:pressed{
    background-color:#0f172a;
    color:#f59e0b;
    border-color:#d97706;
}

/* =========================
   棋盘
   ========================= */

#boardWidget{
    background-color:#1e293b;
    border:2px solid #334155;
    border-radius:14px;
    padding:18px;
}

/* =========================
   侧边面板
   ========================= */

#picture_left, #picture_right{
    background-color:#1e293b;
    border:2px solid #334155;
    border-radius:10px;
}
